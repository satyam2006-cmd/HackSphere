{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/historical/:path*", "destination": "https://hacksphere-production.up.railway.app/historical/:path*" },
    { "source": "/conversion/:path*", "destination": "https://hacksphere-production.up.railway.app/conversion/:path*" },
    { "source": "/outreach/:path*", "destination": "https://hacksphere-production.up.railway.app/outreach/:path*" },
    { "source": "/health", "destination": "https://hacksphere-production.up.railway.app/health" }
  ]
}
