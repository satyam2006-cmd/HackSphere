{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/historical/:path*", "destination": "${VITE_API_URL}/historical/:path*" },
    { "source": "/conversion/:path*", "destination": "${VITE_API_URL}/conversion/:path*" },
    { "source": "/outreach/:path*", "destination": "${VITE_API_URL}/outreach/:path*" },
    { "source": "/health", "destination": "${VITE_API_URL}/health" }
  ]
}
