# Optional LLM integration.
# "disabled" keeps development deterministic by using the local fallback adapter.
# External providers are not enabled until a dedicated provider adapter is configured.
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_ENDPOINT=
LLM_MODEL=

# CORS – comma-separated list of allowed origins for the API.
# Use "*" for local development; set to your Vercel URL in production.
# Example: https://hacksphere.vercel.app
CORS_ORIGINS=*

# SMTP outreach emails (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
SMTP_SIMULATE=true

# Railway injects PORT automatically; only needed for local override.
# PORT=8000
